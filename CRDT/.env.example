# ==========================================
# CRDT Server Environment Variables Template
# ==========================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요

# ── Server Port ──
PORT=8898

# ── Backend API URL ──
# 프로덕션 (배포 시 주석 해제)
# SPRING_BASE_URL=https://your-domain.com/

# 로컬 개발
SPRING_BASE_URL=http://localhost:8080

# ── Internal Auth (백엔드 통신용 API 키) ──
INTERNAL_API_KEY=
