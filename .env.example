# ==========================================
# ProjecTree Environment Variables Template
# ==========================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# cp .env.example .env

# ── Database (PostgreSQL) ──
POSTGRES_USER=projectree
POSTGRES_PASSWORD=projectree123
POSTGRES_DB=projectree

# ── Redis ──
# (no config needed - defaults used)

# ── LiveKit ──
LIVEKIT_KEY=
LIVEKIT_SECRET=

# ── OAuth2 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── JWT ──
JWT_SECRET=

# ── CRDT ──
INTERNAL_API_KEY=

# ── Email (Gmail SMTP) ──
SPRING_MAIL_PASSWORD=

# ── AWS S3 / LocalStack ──
# 로컬 개발: LocalStack 사용 (무료 S3 에뮬레이터)
# 프로덕션: 실제 AWS 인증정보로 변경 + ENDPOINT 제거
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=test
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=test
SPRING_CLOUD_AWS_S3_BUCKET=projectree-local
SPRING_CLOUD_AWS_S3_REGION=ap-northeast-2
SPRING_CLOUD_AWS_ENDPOINT=http://localstack:4566

# ── CORS (프론트엔드 주소) ──
# 로컬: localhost:5173, 운영: 실제 도메인으로 변경
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AI / LLM ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
UPSTAGE_API_KEY=
TAVILY_API_KEY=

# ── Langfuse (AI Observability) ──
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
