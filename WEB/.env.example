# ==========================================
# WEB (Frontend) Environment Variables Template
# ==========================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요

# 개발/배포용 env 파일을 따로 구분해서 만들어주세요
# 개발환경 파일명 : .env.development
# 배포환경 파일명 : .env.production

# ── 프로덕션 설정 (.env.production) ──
VITE_CRDT_SERVER_URL=https://your-domain.com/crdt/ws
VITE_API_URL=https://your-domain.com/api/
VITE_WS_URL=https://your-domain.com
VITE_LIVEKIT_URL=wss://your-domain.com/livekit

# ── 로컬 개발 설정 (.env.development) ──
VITE_CRDT_SERVER_URL=ws://localhost:8898
VITE_API_URL=http://localhost:8080/api/
VITE_WS_URL=ws://localhost:7092
VITE_LIVEKIT_URL=ws://localhost:7880