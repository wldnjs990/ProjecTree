# ==========================================
# SERVER Environment Variables Template
# ==========================================
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# 루트 디렉토리의 .env 파일을 사용해도 됩니다 (docker-compose 사용 시)

# ── Database (PostgreSQL) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/projectree
SPRING_DATASOURCE_USERNAME=projectree
SPRING_DATASOURCE_PASSWORD=projectree123

# ── Redis ──
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── OAuth2 Google ──
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# ── OAuth2 GitHub ──
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=

# ── Email (Gmail SMTP) ──
# Gmail 앱 비밀번호 (2단계 인증 필요)
SPRING_MAIL_USERNAME=team.projectree.dev@gmail.com
SPRING_MAIL_PASSWORD=

# ── AWS S3 / LocalStack ──
# 로컬 개발: LocalStack 사용 (무료 S3 에뮬레이터, docker-compose에 포함)
#   - 인증정보: test/test (LocalStack 기본값)
#   - 엔드포인트: http://localstack:4566
# 프로덕션: 실제 AWS S3 사용
#   - 인증정보: 실제 AWS Access Key/Secret Key 입력
#   - 엔드포인트: 비워두기 (실제 AWS S3 사용)
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=test
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=test
SPRING_CLOUD_AWS_S3_BUCKET=projectree-local
SPRING_CLOUD_AWS_S3_REGION=ap-northeast-2
SPRING_CLOUD_AWS_ENDPOINT=http://localstack:4566

# ── LiveKit (음성채팅) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI Inference Server ──
INFERENCE_SERVER_URL=http://localhost:8000
INFERENCE_SERVER_PATH_PREFIX=/inference-api/v1
INFERENCE_SERVER_GENERATE_CANDIDATE_PATH=/candidates
INFERENCE_SERVER_GENERATE_NODE_PATH=/node
INFERENCE_SERVER_RECOMMEND_TECH_PATH=/tech-stacks
INFERENCE_SERVER_GENERATE_PORTFOLIO_PATH=/portfolio

# ── CRDT Server ──
CRDT_SERVER_URL=http://localhost:8899
CRDT_SERVER_PATH_PREFIX=/internal
CRDT_SERVER_NEW_NODE_PATH=/workspaces/{workspaceId}/nodes
CRDT_SERVER_NEW_CUSTOM_TECH_PATH=/workspaces/{workspaceId}/nodes/{nodeId}/custom-tech-stacks
CRDT_SERVER_NEW_TECH_PATH=/workspaces/{workspaceId}/nodes/{nodeId}/tech-stacks
CRDT_SERVER_NEW_CANDIDATE_PATH=/workspaces/{workspaceId}/nodes/{nodeId}/candidate

# ── Workspace ──
WORKSPACE_INVITE_URL=http://localhost:5173/invite

# ── Internal Auth (CRDT 서버 통신용) ──
INTERNAL_AUTH_API_KEY=

# ── JWT ──
JWT_SECRET=

# ── CORS (프론트엔드 주소) ──
# 로컬: http://localhost:5173
# 프로덕션: https://your-domain.com
# 여러 도메인: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
